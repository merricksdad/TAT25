customshadervs vsvt_sky
customshaderfs fst_sky

texture0 tx_skyauto01
texture6 tx_skycolor01

parameter int USE_SUN_ORBIT_FLEX 0
parameter float SunIntensity 3.0
parameter float SunRadius 5.0
parameter int RENDER_SUN_LATE 0
parameter int RENDER_SUN_NOISE 0

##Sun Glow Options 
##0 = off
##1 = standard mix day diffuse color (old way)
##2 = small fraction add diffuse color
##3 = opposite standard mix plus small fraction add
parameter int RENDER_SUN_GLOW 1


parameter float MoonIntensity 0.5
parameter float MoonRadius 4.0
parameter int RENDER_MOON_PHASES 0
parameter int RENDER_MOON_LATE 0
parameter int RENDER_MOON_GLOW 1

parameter int USE_SECOND_MOON 0
parameter float SecondMoonIntensity 0.2
parameter float SecondMoonRadius 3.0
##0 second moon after first
##1 second moon before first
parameter float SECOND_MOON_ORDER 1

parameter int RENDER_STARS 1
parameter float StarDensity 0.2
parameter float StarMaxSize 0.1

parameter int RENDER_CLOUDS 0
parameter int USE_TWO_LAYER_CLOUDS 0
parameter float CloudScale 0.05
parameter float CloudSpeed 0.005
parameter float CloudBaseLum 0.7
parameter float CloudLightenRate 0.5
parameter float CloudCover 0.2
parameter float CloudAlpha 8.0
parameter float CloudSkyTint 0.5
parameter float CloudPasses 8.0

parameter int WeatherTypeOverride -1
parameter float WeatherDensityOverride 0.0

parameter int USE_HORIZON_MODS 0
parameter int SkyLowestRender -65

parameter float SpaceColor 0.0 0.0 0.0 1.0
