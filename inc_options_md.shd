#ifndef INC_OPTIONS_MD
	#define INC_OPTIONS_MD

	//*************************************
	//Option Switches
	//*************************************

	//Causes burn by distance from player
	//1: meshes affected by custom shaders (including water)
	//2: also affects skybox
	#define SOLAR_BURN 1

	//Shifts the start distance for burn
	//Range {-1,1}, negative values pull the range toward the player
	#define SOLAR_BURN_DIST 0.0

	//Set the burn strength
	#define SOLAR_BURN_POWER 1.5
	
	//enable/disable foliage culling by distance
	#define FOLIAGE_CULLING_ENABLED 1
	
	//Set the default cull distance for foliage shader 
	//Note: to disable culling per material, set parameter FoliageMaxDrawDist = -1.0
	#define FOLIAGE_DEFAULT_CULL_DISTANCE 45.0

	//Set the default lighting distance for foliage shader 
	//Note: to disable, set value to -1.0
	#define FOLIAGE_DEFAULT_LIGHTING_DISTANCE 15.0

	//enable/disable foliage brightening by original saturation
	#define FOLIAGE_SATURATION_BRIGHTENING_ENABLED 0
	
	//enable distance perspective transform
	#define PERSPECTIVE_SHIFT 0





	//*************************************
	//Option-related functions. Do not modify
	//*************************************



	#ifndef SOLAR_BURN
		#define SOLAR_BURN 0
	#endif

	#if SOLAR_BURN > 0
		vec3 burn (vec3 vColor, float fFactor) 
		{
			float fR = pow(vColor.r, 1.0/fFactor);
			float fG = pow(vColor.g, 1.0/fFactor);
			float fB = pow(vColor.b, 1.0/fFactor);
			return vec3(fR, fG, fB);
		}
	#endif
	
#endif